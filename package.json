{
  "name": "@adibacsi/pi-jack",
  "version": "1.0.0",
  "description": "JACK (JSON Agent Contractor Kit): Pi extension for delegating to subagents under a JSON Schema contract, for structured, reliable, and type-safe agent responses.",
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "subagents",
    "json-schema"
  ],
  "homepage": "https://github.com/adamjakab/pi-jack#readme",
  "bugs": "https://github.com/adamjakab/pi-jack/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adamjakab/pi-jack.git"
  },
  "license": "MIT",
  "author": "Adam Jakab",
  "type": "module",
  "main": "index.ts",
  "files": [
    "index.ts",
    "agents.ts",
    "contract.ts",
    "json-schema.ts",
    "agents/",
    "prompts/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "prompts": [
      "./prompts/*.md"
    ]
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node tests/e2e/test-tool.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "vitest": "^5.0.3"
  }
}

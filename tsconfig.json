{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "paths": {
      "typebox/value": ["./.pi-modules/typebox/build/value/index.d.mts"],
      "@earendil-works/*": ["./.pi-modules/@earendil-works/*"],
      "*": ["./.pi-modules/*"]
    }
  },
  "include": ["*.ts", "tests/**/*.ts"]
}
